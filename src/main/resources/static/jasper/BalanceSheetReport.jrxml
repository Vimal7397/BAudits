					<font fontName="SansSerif" size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[BALANCE SHEET]]></text>
			</staticText>
			<!-- Spacer Column (Col F) -->
			<staticText>
				<reportElement x="630" y="50" width="30" height="30" uuid="10000000-0000-0000-0000-000000000003"/>
				<text><![CDATA[]]></text>
			</staticText>
			<!-- LIABILITY Header -->
			<staticText>
				<reportElement mode="Opaque" x="660" y="50" width="630" height="30" backcolor="#E9ECEF" uuid="10000000-0000-0000-0000-000000000004"/>
