<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for Balance Sheet & Liability side-by-side single-sheet Excel export -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="BalanceSheetReport" 
              pageWidth="1290" 
              pageHeight="842" 
              columnWidth="1290" 
              leftMargin="0" 
              rightMargin="0" 
              topMargin="0" 
              bottomMargin="0" 
              isIgnorePagination="true" 
              uuid="7d29476d-119d-4f82-a948-a8e39c97af50">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<parameter name="DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA["31-03-2026"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH ASSETS AS (
    SELECT 
        a.GLSH_CODE || '-' || a.GLSH_DESC AS A_GL_HEAD,
        a.ACCT_NUM AS A_ACCT_NUM,
        a.ACCT_NAME AS A_ACCT_NAME,
        a.ACCT_CRNCY AS A_ACCT_CRNCY,
        ABS(b.TRAN_DATE_BAL) AS A_AMOUNT,
        ROW_NUMBER() OVER (ORDER BY a.ACCT_NUM ASC) AS RNUM
    FROM DAB_VIEW b
    JOIN COA_VIEW a ON a.ACCT_NUM = b.ACCT_NUM
    WHERE a.CLASSIFICATION = 'Asset'
      AND TO_DATE($P{DATE}, 'DD-MM-YYYY') BETWEEN b.TRAN_DATE AND b.END_TRAN_DATE
),
LIABILITIES AS (
    SELECT 
        a.GLSH_CODE || '-' || a.GLSH_DESC AS L_GL_HEAD,
        a.ACCT_NUM AS L_ACCT_NUM,
        a.ACCT_NAME AS L_ACCT_NAME,
        a.ACCT_CRNCY AS L_ACCT_CRNCY,
        ABS(b.TRAN_DATE_BAL) AS L_AMOUNT,
        ROW_NUMBER() OVER (ORDER BY a.ACCT_NUM ASC) AS RNUM
    FROM DAB_VIEW b
    JOIN COA_VIEW a ON a.ACCT_NUM = b.ACCT_NUM
    WHERE a.CLASSIFICATION IN ('Liability', 'Equity')
      AND TO_DATE($P{DATE}, 'DD-MM-YYYY') BETWEEN b.TRAN_DATE AND b.END_TRAN_DATE
),
NUMS AS (
    SELECT RNUM FROM ASSETS
    UNION
    SELECT RNUM FROM LIABILITIES
)
SELECT 
    a.A_GL_HEAD, a.A_ACCT_NUM, a.A_ACCT_NAME, a.A_ACCT_CRNCY, a.A_AMOUNT,
    l.L_GL_HEAD, l.L_ACCT_NUM, l.L_ACCT_NAME, l.L_ACCT_CRNCY, l.L_AMOUNT
FROM NUMS n
LEFT JOIN ASSETS a ON n.RNUM = a.RNUM
LEFT JOIN LIABILITIES l ON n.RNUM = l.RNUM
ORDER BY n.RNUM ASC]]>
	</queryString>
	<field name="A_GL_HEAD" class="java.lang.String"/>
	<field name="A_ACCT_NUM" class="java.lang.String"/>
	<field name="A_ACCT_NAME" class="java.lang.String"/>
	<field name="A_ACCT_CRNCY" class="java.lang.String"/>
	<field name="A_AMOUNT" class="java.math.BigDecimal"/>
	<field name="L_GL_HEAD" class="java.lang.String"/>
	<field name="L_ACCT_NUM" class="java.lang.String"/>
	<field name="L_ACCT_NAME" class="java.lang.String"/>
	<field name="L_ACCT_CRNCY" class="java.lang.String"/>
	<field name="L_AMOUNT" class="java.math.BigDecimal"/>
	<variable name="TOTAL_ASSET" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{A_AMOUNT}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_LIABILITY" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{L_AMOUNT}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="80" splitType="Stretch">
			<!-- Report Status at Top -->
			<textField evaluationTime="Report" isBlankWhenNull="true">
				<reportElement mode="Opaque" x="0" y="0" width="1290" height="25" backcolor="#FFFFFF" uuid="10000000-0000-0000-0000-000000000005"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Report Status : " + ($V{TOTAL_ASSET} == null || $V{TOTAL_LIABILITY} == null ? "N/A" : ($V{TOTAL_ASSET}.compareTo($V{TOTAL_LIABILITY}) > 0 ? "Profit" : ($V{TOTAL_ASSET}.compareTo($V{TOTAL_LIABILITY}) < 0 ? "Loss" : "Break-even")))]]></textFieldExpression>
			</textField>

			<!-- Profit / Loss Amount at Top -->
			<textField evaluationTime="Report" isBlankWhenNull="true">
				<reportElement mode="Opaque" x="0" y="25" width="1290" height="25" backcolor="#FFFFFF" uuid="10000000-0000-0000-0000-000000000006"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{TOTAL_ASSET} == null || $V{TOTAL_LIABILITY} == null ? "" : ($V{TOTAL_ASSET}.compareTo($V{TOTAL_LIABILITY}) > 0 ? "Profit Amount: " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_ASSET}.subtract($V{TOTAL_LIABILITY})) : ($V{TOTAL_ASSET}.compareTo($V{TOTAL_LIABILITY}) < 0 ? "Loss Amount: " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_LIABILITY}.subtract($V{TOTAL_ASSET})) : "No Profit or Loss"))]]></textFieldExpression>
			</textField>

			<!-- ASSET Header -->
			<staticText>
				<reportElement mode="Opaque" x="0" y="50" width="160" height="30" backcolor="#E9ECEF" uuid="10000000-0000-0000-0000-000000000001"/>
				<box>
